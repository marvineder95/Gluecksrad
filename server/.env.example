# Kopiere zu .env (oder setze als echte Umgebungsvariablen).
# DEV-Defaults sind in config.go hinterlegt; hier für Produktion überschreiben.

# Postgres-Verbindung (Produktion: nativer Postgres auf dem Server)
DATABASE_URL=host=localhost port=5432 user=gluecksrad password=CHANGE_ME dbname=gluecksrad sslmode=disable

# HTTP-Port (Nginx proxied /api/ hierhin)
PORT=8090

# dev | prod  (prod schaltet SQL-Query-Logging aus)
APP_ENV=prod
