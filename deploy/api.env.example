# Kopie nach /etc/gluecksrad/api.env (chmod 600, chown www-data). NICHT ins Repo committen.
# Wird von der systemd-Unit als EnvironmentFile geladen.

# Postgres (lokal auf dem Server)
DATABASE_URL=host=127.0.0.1 port=5432 user=gluecksrad password=CHANGE_ME dbname=gluecksrad sslmode=disable

# HTTP-Port (Nginx proxied /api/ hierhin)
PORT=8090

# prod schaltet SQL-Query-Logging aus
APP_ENV=prod

# Wurzel der statischen Frontend-Dateien (index.html, frontend/, uploads/)
STATIC_DIR=/var/www/gluecksrad

# E-Mail via Resend (gleiche Werte wie bisher genutzt)
MAIL_DRIVER=resend
RESEND_API_KEY=re_CHANGE_ME
MAIL_FROM=noreply@kwlc.pl
MAIL_FROM_NAME=Glücksrad
MAIL_REPLY_TO=kontakt@kwlc.pl
APP_URL=https://spin.kwlc.pl
